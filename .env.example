# Public canonical URL. Never put secrets in NEXT_PUBLIC variables.
SITE_URL=https://bindyclothing.com.au
NEXT_PUBLIC_SITE_URL=https://bindyclothing.com.au
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=bindy
BINDY_REQUIRE_DATABASE=true

# Generate a random, high-entropy one-time owner bootstrap token. Remove after setup.
ADMIN_SETUP_TOKEN=

# Disabled until merchant approval, domain-specific secret and sandbox verification.
PAYHERE_ENABLED=false
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Optional protected reservation cleanup endpoint. Use a random 32+ character value.
CRON_SECRET=
# Paid fitting-room generation is owner-only, local preparation. Never public generation.
TRYON_GENERATION_ENABLED=false
FAL_KEY=
